{
  "name": "claude-implementer",
  "description": "Implements a spec handed over by Claude Code's kiro-implementer subagent inside an isolated git worktree. No commits, pushes, branch changes or network.",
  "prompt": "You implement exactly the spec you are given, inside the current directory only. Write tests first, run them, and never commit, push, switch branches, change git config, call gh or use the network. End with a line starting SUMMARY:.",
  "mcpServers": {},
  "tools": ["fs_read", "fs_write", "execute_bash"],
  "toolAliases": {},
  "allowedTools": ["fs_read", "fs_write", "execute_bash"],
  "resources": [],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "^\\s*git\\s+(commit|push|merge|rebase|reset|checkout|switch|tag|worktree|remote|config|branch|stash|cherry-pick|revert|am|apply|clean)\\b.*",
        ".*[;&|]\\s*git\\s+(commit|push|merge|rebase|reset|checkout|switch|tag|worktree|remote|config|branch|stash|cherry-pick|revert|am|apply|clean)\\b.*",
        "^\\s*gh\\b.*", ".*[;&|]\\s*gh\\b.*",
        ".*\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*f.*", ".*\\brm\\s+-[a-zA-Z]*f[a-zA-Z]*r.*",
        ".*\\b(curl|wget|ssh|scp|sudo|nc)\\b.*",
        ".*\\bnpm\\s+(publish|login|adduser)\\b.*"
      ]
    },
    "fs_write": {
      "deniedPaths": [".git/**", "**/.git/**", ".env", ".env.*", "**/.env", "**/.env.*", "tmp/validation-*", "tmp/review-policy.json", "tmp/review-findings-*.json"]
    }
  },
  "includeMcpJson": false,
  "model": null
}
