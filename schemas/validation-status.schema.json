{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-status.schema.json",
  "title": "Validation Status v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "snapshot",
    "results",
    "evidence",
    "overall",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent-validator",
        "doc-validator",
        "security-validator",
        "code-simplifier",
        "test-validator"
      ],
      "properties": {
        "intent-validator": {
          "$ref": "#/$defs/result"
        },
        "doc-validator": {
          "$ref": "#/$defs/result"
        },
        "security-validator": {
          "$ref": "#/$defs/result"
        },
        "code-simplifier": {
          "$ref": "#/$defs/result"
        },
        "test-validator": {
          "$ref": "#/$defs/result"
        },
        "cli-validator": {
          "$ref": "#/$defs/result"
        },
        "visual-qa": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "SKIP",
            "PENDING"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "overall": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "result": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "SKIP"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "started_at",
        "repository",
        "branch",
        "base_branch",
        "head_sha",
        "base_sha",
        "plan_sha256",
        "cli_config_sha256",
        "cli_required"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "plan_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "cli_config_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "cli_required": {
          "type": "boolean"
        }
      }
    }
  }
}
