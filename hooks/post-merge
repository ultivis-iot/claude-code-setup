#!/bin/sh
# Refresh the current worktree's local Graft graph after merge/pull.
# Ultivis Graft graph refresh
# git 이 sh 로 실행하므로(Windows 포함) 얇은 래퍼만 두고 실제 일은 Node 스크립트가 한다.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
REFRESH="$HOOK_DIR/workflow/scripts/graft.mjs"

if [ -f "$REFRESH" ] && command -v node >/dev/null 2>&1; then
    node "$REFRESH" refresh "$REPO" post-merge || true
fi
exit 0
