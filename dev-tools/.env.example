# Isaac dev-tools 환경 설정
# 이 파일을 .env로 복사 후 경로를 수정하세요

# Worktree들이 생성되는 상위 디렉토리
# 예: /home/user/Git (여러 프로젝트 repo가 모여있는 곳)
WORKTREE_ROOT="$HOME/Git"

# Notion API 직접 호출 스크립트용 토큰
# Claude MCP 설정을 쓰지 않는 환경(Codex 단독 설치 등)에서는 이 값을 설정하세요.
# export NOTION_TOKEN="ntn_..."

# ============================================
# Docker 멀티유저 격리 설정 (프로젝트에 따라 선택사항)
# ============================================
# 아래 설정을 생략하면 사용자명 해시 기반으로 자동 계산됩니다.
#
# 프로젝트 이름 (컨테이너/볼륨/네트워크 prefix, 기본값: pm-$(whoami))
# export COMPOSE_PROJECT_NAME="pm-myname"
#
# 포트 오프셋 (0~49, 기본값: 사용자명 해시)
# export PM_PORT_OFFSET=0
#
# 개별 포트 오버라이드 (기본값: 기본포트 + PM_PORT_OFFSET * 100)
# export PM_TRAEFIK_PORT=30080
# export PM_API_PORT=38000
# export PM_PG_PORT=35432
# export PM_REDIS_PORT=36379
# export PM_MINIO_PORT=39000
# export PM_MINIO_CONSOLE_PORT=39001
# export PM_VITE_PORT=20173
# export PM_FLOWER_PORT=35555
# export PM_SMTP_PORT=32525
